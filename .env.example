# ==================== Database (Supabase Postgres in prod, SQLite in dev) ====================
# In dev: SQLite locale (file:./db/custom.db)
# In prod (Vercel): imposta DATABASE_URL con la connection string di Supabase
DATABASE_URL="file:./db/custom.db"

# ==================== Cloudflare R2 ====================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="portale-pfc"

# ==================== Sicurezza app ====================
# Secret per firmare i JWT di sessione (almeno 32 caratteri random)
# Genera con: openssl rand -hex 32
APP_SECRET="dev-secret-cambia-in-produzione-32char-minimo"

# ==================== Opzionali ====================
NODE_ENV="production"
